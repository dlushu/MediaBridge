  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/dlushu/MediaBridge.git"
  },
  "keywords": [
    "emby",
    "aggregator",
    "media"
  ],
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node tools/check-syntax.js && node tools/check-style.js"
  },
  "engines": {
    "node": ">=22.13"
  }
